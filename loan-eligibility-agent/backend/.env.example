# Loan Eligibility Agent - Environment Variables
# Copy this file to .env and fill in your values

# Application Settings
APP_NAME="Loan Eligibility Agent"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development

# API Settings
API_V1_PREFIX=/api/v1

# Google Cloud Platform
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# Dialogflow CX
DIALOGFLOW_AGENT_ID=your-dialogflow-agent-id
DIALOGFLOW_LANGUAGE_CODE=en

# Vertex AI / LLM Settings
VERTEX_AI_MODEL=gemini-1.5-pro
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# OpenAI (alternative to Vertex AI)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# Security
API_KEY=your-api-key-for-authentication
CORS_ORIGINS=["http://localhost:3000","https://yourdomain.com"]

# Logging
LOG_LEVEL=INFO
SPLUNK_HEC_URL=https://your-splunk-instance:8088/services/collector
SPLUNK_HEC_TOKEN=your-splunk-hec-token

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
