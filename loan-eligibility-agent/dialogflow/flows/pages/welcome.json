            "parameter": "loan_type",
            "value": "auto"
          }
        ]
      }
    },
    {
      "intent": "loan.type.business",
      "targetPage": "Collect Loan Amount",
      "triggerFulfillment": {
        "setParameterActions": [
          {
            "parameter": "loan_type",
            "value": "business"
          }
        ]
      }
    },
    {
      "intent": "loan.type.education",
