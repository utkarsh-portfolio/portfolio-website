{
  "displayName": "Collect Employment",
  "entryFulfillment": {
    "messages": [
      {
        "text": {
          "text": [
            "Thank you. What is your current employment status?\n\n• Employed (full-time or part-time)\n• Self-employed\n• Retired\n• Student\n• Currently not employed"
          ]
        }
      }
