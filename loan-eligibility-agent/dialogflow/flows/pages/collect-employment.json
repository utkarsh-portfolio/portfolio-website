          "initialPromptFulfillment": {
            "messages": [
              {
                "text": {
                  "text": ["Please select your employment status."]
                }
              }
            ]
          }
        }
      }
    ]
  },
  "transitionRoutes": [
    {
      "condition": "$page.params.employment_status != null",
      "targetPage": "Collect Credit Score"
    }
  ]
}
